RELAY_NAME="Plebeian Market Relay"
RELAY_DESCRIPTION="Application relay for plebeian.market"
RELAY_CONTACT=""
RELAY_ICON=""
RELAY_PUBKEY=""
RELAY_PUBLIC_URL="wss://relay.plebeian.market"
RELAY_LISTEN_ADDR="127.0.0.1:3334"
RELAY_DATA_DIR="/var/lib/market-relay"
RELAY_SEARCH_INDEX_DIR="/var/lib/market-relay/search"
RELAY_RAW_DB_DIR="/var/lib/market-relay/raw"
RELAY_MAX_QUERY_LIMIT="500"
RELAY_SUPPORTED_NIPS="1,11,50"
RELAY_READ_HEADER_TIMEOUT_MS="10000"
RELAY_SHUTDOWN_TIMEOUT_MS="10000"
# Heap headroom: GOGC=50 targets ~1.5x live. Set GOMEMLIMIT once the live
# heap is measured with GODEBUG=gctrace=1; it must stay above the live heap.
GOGC=50
# GOMEMLIMIT=3500MiB
