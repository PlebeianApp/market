RELAY_NAME="Plebeian Market Relay"
RELAY_DESCRIPTION="Application relay for plebeian.market"
RELAY_CONTACT=""
RELAY_ICON=""
RELAY_PUBKEY=""
RELAY_PUBLIC_URL="wss://relay.plebeian.market"
RELAY_LISTEN_ADDR="127.0.0.1:3334"
RELAY_DATA_DIR="/var/lib/market-relay"
RELAY_SEARCH_INDEX_DIR="/var/lib/market-relay/search"
RELAY_RAW_DB_DIR="/var/lib/market-relay/raw"
RELAY_MAX_QUERY_LIMIT="500"
RELAY_SEARCH_KINDS="0,30402"
RELAY_SUPPORTED_NIPS="1,11,50"
RELAY_READ_HEADER_TIMEOUT_MS="10000"
RELAY_SHUTDOWN_TIMEOUT_MS="10000"

# Go heap policy measured 2026-11-17 with GODEBUG=gctrace=1 on the 79 GB-index
# build: live heap ~2.09 GB; the default GOGC=100 goal was ~4.18 GB and peaked
# at 6.2 GB, above the 5 GiB cgroup. GOGC=50 targets ~3.1 GB; GOMEMLIMIT is a
# soft backstop above the measured live heap, not a replacement for MemoryMax.
# Re-measure after the scoped search-index rebuild and lower it if live drops.
GOGC=50
GOMEMLIMIT=3500MiB
