# Documentation-only validator environment. Replace every angle-bracket value.
FRIDAY_APPLICATION=/etc/plebeian-auctions-friday/application.json
FRIDAY_ROLE=VALIDATOR_SIGNER
FRIDAY_SLOT=<REPLACE_WITH_SLOT_1_TO_4>
FRIDAY_NETWORK_ROOT=/var/lib/plebeian-auctions-friday/network-separated
FRIDAY_NETWORK_FACTS=/var/lib/plebeian-auctions-friday/network-separated/network-facts.json
FRIDAY_DKG_RESULT=/var/lib/plebeian-auctions-friday/separated-inputs/runtime-binding.json
FRIDAY_PARTICIPANT_BIN=/opt/plebeian-auctions-friday/releases/REPLACE/bin/coco-demo-frost-participant-3of4
FRIDAY_TERMINAL_EXECUTOR_BIN=/opt/plebeian-auctions-friday/releases/REPLACE/bin/plebeian-friday-terminal-executor
FRIDAY_COORDINATOR_DB=/var/lib/plebeian-auctions-friday/coordinator-v3/runtime/operations.sqlite3
FRIDAY_COORDINATOR_ANCHOR_DB=/var/lib/plebeian-auctions-friday-anchor-separated/coordinator.sqlite3
FRIDAY_FUNDING_ABORT_ANCHOR_DB=/var/lib/plebeian-auctions-friday-anchor-separated/funding-abort.sqlite3
FRIDAY_FIPS_CONFIG=/var/lib/plebeian-auctions-friday/fips/identity/fips.yaml
FRIDAY_FIPS_IDENTITY_KEY=/var/lib/plebeian-auctions-friday/fips/identity/fips.key
FRIDAY_FIPS_UNDERLAY_IPV4=192.0.2.11
FRIDAY_FIPS_ULA=fd00::11
FRIDAY_P2P_PORT=27656
FRIDAY_RPC_PORT=27657
FRIDAY_SIGNER_PORT=39101
FRIDAY_MINT_PORT=3438
FRIDAY_SITE_PORT=8180
FRIDAY_DEPLOYMENT_ANCHOR_SHA256=<REPLACE_WITH_64_LOWERCASE_HEX>
FRIDAY_DKG_MANIFEST_DIGEST=<REPLACE_WITH_64_LOWERCASE_HEX>
FRIDAY_NETWORK_FACTS_SHA256=<REPLACE_WITH_64_LOWERCASE_HEX>
FRIDAY_OWNER_APPROVAL_PUBLIC_KEY=<REPLACE_WITH_PUBLIC_KEY>
FRIDAY_SEPARATED_BOOTSTRAP_DIGEST=<REPLACE_WITH_64_LOWERCASE_HEX>
FRIDAY_SEPARATED_RUNTIME_DIGEST=<REPLACE_WITH_64_LOWERCASE_HEX>
POC_FRIDAY_BROWSER_PINS_SHA256=<REPLACE_WITH_64_LOWERCASE_HEX>
POC_FRIDAY_HEALTH_PINS_SHA256=<REPLACE_WITH_64_LOWERCASE_HEX>
POC_FRIDAY_BROWSER_READY=false
POC_FRIDAY_R20_CLOSE_TRIGGER=false
POC_FRIDAY_RECOVERY_ONLY=false
