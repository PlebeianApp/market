[Unit]
Description=Plebeian Friday fake-money threshold payment coordinator
Wants=plebeian-friday-validator.service plebeian-friday-signer.service
After=plebeian-friday-validator.service plebeian-friday-signer.service
ConditionPathExists=/etc/plebeian-auctions-friday/application.json
ConditionPathExists=/opt/plebeian-auctions-friday/bin/plebeian-friday-terminal-executor
ConditionPathExists=/var/lib/plebeian-auctions-friday-anchor/coordinator.sqlite3
ConditionPathExists=/var/lib/plebeian-auctions-friday/coordinator/coordinator-rpc-identity.key

[Service]
Type=simple
User=plebeian-friday
Group=plebeian-friday
Slice=plebeian-friday.slice
RuntimeDirectory=plebeian-friday-coordinator
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
EnvironmentFile=/etc/plebeian-auctions-friday/friday.env
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/bin/verify-friday-runtime-target.py --environment /etc/plebeian-auctions-friday/friday.env --application ${FRIDAY_APPLICATION} --service plebeian-friday-coordinator.service
ExecStart=/opt/plebeian-auctions-friday/bin/plebeian-friday-coordinator serve --application ${FRIDAY_APPLICATION} --database ${FRIDAY_COORDINATOR_DB} --rollback-anchor-database ${FRIDAY_COORDINATOR_ANCHOR_DB} --executor-binary ${FRIDAY_TERMINAL_EXECUTOR_BIN}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/plebeian-auctions-friday/coordinator /var/lib/plebeian-auctions-friday-anchor
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
TasksMax=192
LimitNOFILE=8192
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
