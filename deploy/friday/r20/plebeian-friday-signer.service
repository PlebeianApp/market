[Unit]
Description=Plebeian Friday R20 fake-money FROST signer (fail-stop)
Requires=plebeian-friday-fips.service plebeian-friday-validator.service
After=plebeian-friday-fips.service plebeian-friday-validator.service

[Service]
Type=simple
User=plebeian-friday
Group=plebeian-friday
Slice=plebeian-friday.slice
UMask=0077
EnvironmentFile=/etc/plebeian-auctions-friday/friday.env
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/releases/r20-deploy-v1/bin/verify-friday-runtime-target.py --environment /etc/plebeian-auctions-friday/friday.env --application ${FRIDAY_APPLICATION} --service plebeian-friday-signer.service
ExecStart=/opt/plebeian-auctions-friday/releases/r20-deploy-v1/bin/plebeian-friday-signer serve --application ${FRIDAY_APPLICATION} --dkg-result ${FRIDAY_DKG_RESULT} --expected-manifest-digest ${FRIDAY_DKG_MANIFEST_DIGEST} --network-facts ${FRIDAY_NETWORK_FACTS} --slot ${FRIDAY_SLOT} --participant-binary ${FRIDAY_PARTICIPANT_BIN} --r20-profile ${FRIDAY_R20_PROFILE} --r20-predecessor-manifest ${FRIDAY_R20_PREDECESSOR_MANIFEST} --r20-bound-manifest ${FRIDAY_R20_BOUND_MANIFEST} --expected-r20-manifest-binding-digest ${FRIDAY_R20_MANIFEST_BINDING_DIGEST} --expected-r20-runtime-binding-digest ${FRIDAY_R20_RUNTIME_BINDING_DIGEST}
Restart=no
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Mandatory literal per-slot 20-r20-state.conf is checked by ExecStartPre.
# Render it offline; no environment expansion is used for state permissions.
ReadWritePaths=/var/lib/plebeian-auctions-friday/frost-v2/keyset-v2
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=320M
TasksMax=192
LimitNOFILE=8192
