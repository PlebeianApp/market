# R20 TEMPLATE ONLY. Every token is rendered from one reviewed release manifest.
FRIDAY_SLOT=%FRIDAY_SLOT%
FRIDAY_FIPS_UNDERLAY_IPV4=%FRIDAY_FIPS_UNDERLAY_IPV4%
FRIDAY_FIPS_ULA=%FRIDAY_FIPS_ULA%
FRIDAY_FIPS_CONFIG=/var/lib/plebeian-auctions-friday/fips/identity/fips.yaml
FRIDAY_FIPS_IDENTITY_KEY=/var/lib/plebeian-auctions-friday/fips/identity/fips.key
FRIDAY_P2P_PORT=27656
FRIDAY_RPC_PORT=27657
FRIDAY_SIGNER_PORT=39101
FRIDAY_MINT_PORT=3438
FRIDAY_SITE_PORT=8180
FRIDAY_NETWORK_ROOT=/var/lib/plebeian-auctions-friday/network-r20
FRIDAY_DKG_RESULT=/var/lib/plebeian-auctions-friday/frost-v2/keyset-v2/runtime-binding.json
FRIDAY_DKG_MANIFEST_DIGEST=%FRIDAY_DKG_MANIFEST_DIGEST%
FRIDAY_R20_PROFILE=/var/lib/plebeian-auctions-friday/frost-v2/r20-inputs/fresh-profile.json
FRIDAY_R20_PREDECESSOR_MANIFEST=/var/lib/plebeian-auctions-friday/frost-v2/r20-inputs/predecessor-manifest.json
FRIDAY_R20_MANIFEST=/var/lib/plebeian-auctions-friday/frost-v2/keyset-v2/manifest.json
FRIDAY_R20_MANIFEST_DIGEST=/var/lib/plebeian-auctions-friday/frost-v2/keyset-v2/owner-approved-manifest-digest.txt
FRIDAY_R20_BOUND_MANIFEST=/var/lib/plebeian-auctions-friday/frost-v2/r20-inputs/bound-manifest.json
FRIDAY_R20_MANIFEST_BINDING_DIGEST=%FRIDAY_R20_MANIFEST_BINDING_DIGEST%
FRIDAY_R20_RUNTIME_BINDING_DIGEST=%FRIDAY_R20_RUNTIME_BINDING_DIGEST%
FRIDAY_NETWORK_FACTS=/var/lib/plebeian-auctions-friday/network-r20/network-facts.json
FRIDAY_APPLICATION=/etc/plebeian-auctions-friday/application.json
FRIDAY_PARTICIPANT_BIN=/opt/plebeian-auctions-friday/releases/r20-deploy-v1/bin/coco-demo-frost-participant-3of4
FRIDAY_COORDINATOR_DB=/var/lib/plebeian-auctions-friday/coordinator-v2/operations.sqlite3
FRIDAY_COORDINATOR_ANCHOR_DB=/var/lib/plebeian-auctions-friday-anchor-r20/coordinator.sqlite3
FRIDAY_FUNDING_ABORT_ANCHOR_DB=/var/lib/plebeian-auctions-friday-anchor-r20/funding-abort.sqlite3
FRIDAY_TERMINAL_EXECUTOR_BIN=/opt/plebeian-auctions-friday/releases/r20-deploy-v1/bin/plebeian-friday-terminal-executor
# Public admission is a separate action after private acceptance evidence.
POC_FRIDAY_BROWSER_READY=false
POC_FRIDAY_BROWSER_PINS_SHA256=%FRIDAY_BROWSER_PINS_SHA256%
# Independent reviewed mint identity/conformance input; missing pin disables admissions.
POC_FRIDAY_HEALTH_PINS_SHA256=%FRIDAY_HEALTH_PINS_SHA256%
POC_FRIDAY_RECOVERY_ONLY=false
# Automatic auction close is a separate reviewed admission after private
# browser/payment acceptance. It is fail-closed against all R20 public pins.
POC_FRIDAY_R20_CLOSE_TRIGGER=false
