[Unit]
Description=Plebeian Friday R20 authenticated funding and terminal authority
Wants=plebeian-friday-validator.service plebeian-friday-signer.service plebeian-friday-coordinator.service
After=plebeian-friday-validator.service plebeian-friday-signer.service plebeian-friday-coordinator.service
ConditionPathExists=/var/lib/plebeian-auctions-friday/coordinator-v2/coordinator-rpc-identity.key
ConditionPathExists=/var/lib/plebeian-auctions-friday-anchor-r20/coordinator.sqlite3
ConditionPathExists=/var/lib/plebeian-auctions-friday-anchor-r20/funding-replay.sqlite3
ConditionPathExists=/var/lib/plebeian-auctions-friday-anchor-r20/funding-broadcast.sqlite3
ConditionPathExists=/var/lib/plebeian-auctions-friday-anchor-r20/funding-abort.sqlite3
ConditionPathExists=/var/lib/plebeian-auctions-friday-anchor-r20/seller-plan.sqlite3

[Service]
Type=simple
User=plebeian-friday
Group=plebeian-friday
Slice=plebeian-friday.slice
UMask=0077
EnvironmentFile=/etc/plebeian-auctions-friday/friday.env
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/releases/r20-deploy-v1/bin/verify-friday-runtime-target.py --environment /etc/plebeian-auctions-friday/friday.env --application ${FRIDAY_APPLICATION} --service plebeian-friday-authority.service
ExecStart=/opt/plebeian-auctions-friday/releases/r20-deploy-v1/bin/plebeian-friday-authority serve --application ${FRIDAY_APPLICATION}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/plebeian-auctions-friday/coordinator-v2 /var/lib/plebeian-auctions-friday-anchor-r20
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=448M
TasksMax=192
LimitNOFILE=8192
