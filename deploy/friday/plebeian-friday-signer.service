[Unit]
Description=Plebeian Friday fake-money FROST signer (fail-stop)
Requires=plebeian-friday-fips.service plebeian-friday-validator.service
After=plebeian-friday-fips.service plebeian-friday-validator.service

[Service]
Type=simple
User=plebeian-friday
Group=plebeian-friday
Slice=plebeian-friday.slice
UMask=0077
EnvironmentFile=/etc/plebeian-auctions-friday/friday.env
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/bin/verify-friday-runtime-target.py --environment /etc/plebeian-auctions-friday/friday.env --application ${FRIDAY_APPLICATION} --service plebeian-friday-signer.service
ExecStart=/opt/plebeian-auctions-friday/bin/plebeian-friday-signer serve --application ${FRIDAY_APPLICATION} --dkg-result ${FRIDAY_DKG_RESULT} --expected-manifest-digest ${FRIDAY_DKG_MANIFEST_DIGEST} --network-facts ${FRIDAY_NETWORK_FACTS} --slot ${FRIDAY_SLOT} --participant-binary ${FRIDAY_PARTICIPANT_BIN}
Restart=no
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/plebeian-auctions-friday/frost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=320M
TasksMax=192
LimitNOFILE=8192
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
