[Unit]
Description=Plebeian Friday fake-money FIPS transport
After=network-online.target
Wants=network-online.target
Before=plebeian-friday-validator.service plebeian-friday-signer.service

[Service]
Type=simple
User=plebeian-friday
Group=plebeian-friday
Slice=plebeian-friday.slice
UMask=0077
EnvironmentFile=/etc/plebeian-auctions-friday/friday.env
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/bin/verify-friday-runtime-target.py --environment /etc/plebeian-auctions-friday/friday.env --application ${FRIDAY_APPLICATION} --service plebeian-friday-fips.service
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/bin/verify-friday-fips-identity.py --config ${FRIDAY_FIPS_CONFIG} --key ${FRIDAY_FIPS_IDENTITY_KEY}
ExecStart=/opt/plebeian-auctions-friday/bin/fips -c ${FRIDAY_FIPS_CONFIG}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/plebeian-auctions-friday/fips
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=160M
TasksMax=96
LimitNOFILE=8192
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
