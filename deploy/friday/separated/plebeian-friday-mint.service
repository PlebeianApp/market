[Unit]
Description=Plebeian Friday Separated worthless-token Nutshell FakeWallet mint
Requires=plebeian-friday-fips.service
After=plebeian-friday-fips.service
ConditionPathExists=/etc/plebeian-auctions-friday/mint.env

[Service]
Type=simple
User=plebeian-friday-mint
Group=plebeian-friday-public
Slice=plebeian-friday.slice
UMask=0077
WorkingDirectory=/opt/plebeian-auctions-friday
EnvironmentFile=/etc/plebeian-auctions-friday/friday.env
EnvironmentFile=/etc/plebeian-auctions-friday/mint.env
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/releases/separated-deploy-v1/bin/verify-friday-separated-target.py --environment /etc/plebeian-auctions-friday/friday.env --application ${FRIDAY_APPLICATION} --service plebeian-friday-mint.service
ExecStart=/opt/plebeian-auctions-friday/.venv/bin/python -m cashu.mint --host ${FRIDAY_FIPS_ULA} --port ${FRIDAY_MINT_PORT}
Restart=always
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/plebeian-auctions-friday/mint
RestrictAddressFamilies=AF_INET6 AF_UNIX
MemoryMax=768M
TasksMax=192

LogNamespace=plebeian-friday-separated
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
