[Unit]
Description=Plebeian Friday Separated fake-money auctions site/API
Wants=plebeian-friday-observer.service
After=plebeian-friday-observer.service

[Service]
Type=simple
User=plebeian-friday-site
Group=plebeian-friday-public
Slice=plebeian-friday.slice
EnvironmentFile=/etc/plebeian-auctions-friday/friday.env
ExecStartPre=/usr/bin/python3 -I -S -B /opt/plebeian-auctions-friday/releases/separated-deploy-v1/bin/verify-friday-separated-target.py --environment /etc/plebeian-auctions-friday/friday.env --application ${FRIDAY_APPLICATION} --service plebeian-friday-site.service
ExecStart=/opt/plebeian-auctions-friday/releases/separated-deploy-v1/bin/plebeian-auctions-poc serve --home ${FRIDAY_NETWORK_ROOT} --listen 127.0.0.1:${FRIDAY_SITE_PORT}
Restart=always
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=160M
TasksMax=128

LogNamespace=plebeian-friday-separated
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
