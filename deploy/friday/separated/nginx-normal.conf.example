# Complete Separated location set. Destination:
# /etc/nginx/plebeian-friday-separated-modes/normal.conf (root:root 0644).
location ^~ /v1/ {
    proxy_pass http://[%FRIDAY_APPLICATION_ULA%]:3438;
    proxy_http_version 1.1;
    proxy_set_header Host 139.162.161.233;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    # Browsers control Accept-Encoding themselves. Never offer compression to
    # Nutshell across this proxy: Coco must receive identity response bytes.
    proxy_set_header Accept-Encoding "";
    proxy_redirect off;
    proxy_intercept_errors on;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    client_max_body_size 64k;
    add_header Cache-Control "no-store" always;
}
location ^~ /api/friday/ {
    proxy_pass http://127.0.0.1:8181;
    proxy_http_version 1.1;
    proxy_set_header Host 139.162.161.233;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_cache off;
    client_max_body_size 32k;
    add_header Cache-Control "no-store" always;
}
location / {
    proxy_pass http://127.0.0.1:8180;
    proxy_http_version 1.1;
    proxy_set_header Host 139.162.161.233;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_cache off;
    add_header Cache-Control "no-store" always;
}
