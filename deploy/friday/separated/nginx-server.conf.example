# Separated TEMPLATE ONLY. Destination: /etc/nginx/sites-available/plebeian-friday-separated.conf
# Do not copy it to sites-enabled until private acceptance and a separate
# public-activation approval. The TLS paths are deliberately unresolved gates.
server {
    listen 139.162.161.233:443 ssl default_server;
    server_name 139.162.161.233;
    ssl_certificate %FRIDAY_TLS_FULLCHAIN_PATH%;
    ssl_certificate_key %FRIDAY_TLS_PRIVATE_KEY_PATH%;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log /var/log/nginx/plebeian-friday-separated-access.log;
    error_log /var/log/nginx/plebeian-friday-separated-error.log warn;
    include /etc/nginx/plebeian-friday-separated-active.conf;
}
