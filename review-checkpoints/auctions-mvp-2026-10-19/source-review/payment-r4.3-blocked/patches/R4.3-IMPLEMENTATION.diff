+function v2StringTupleCompare(left: readonly string[], right: readonly string[]): number {
+	for (let index = 0; index < left.length; index += 1) {
+		if (left[index] === right[index]) continue;
+		return left[index]! < right[index]! ? -1 : 1;
+	}
+	return 0;
