+// VerifyPaymentApprovalLifetimeV2 checks the complete frozen terminal-bound
+// admission equation. Envelope verification alone deliberately cannot claim
+// this result because bundle preparation and admission timestamps are owned by
+// the payment lane.
+func VerifyPaymentApprovalLifetimeV2(approval PaymentApprovalV2, bundlePreparedAt, admittedAt int64) error {
+	if !safePositiveIntegerV2(approval.ApprovalCreatedAt) || !safePositiveIntegerV2(bundlePreparedAt) || !safePositiveIntegerV2(admittedAt) || !safePositiveIntegerV2(approval.CloseTime) || !safePositiveIntegerV2(approval.ValidUntil) || !safePositiveIntegerV2(approval.Locktime) || !safePositiveIntegerV2(approval.SettlementWindowSeconds) {
+		return errors.New("payment approval V2 lifetime contains a non-positive or unsafe integer")
+	}
+	if approval.SettlementWindowSeconds < 60 || approval.ApprovalCreatedAt > bundlePreparedAt || bundlePreparedAt > admittedAt || admittedAt > approval.ValidUntil || admittedAt > approval.CloseTime || approval.CloseTime > approval.ValidUntil {
+		return errors.New("payment approval V2 lifetime ordering is invalid")
+	}
+	if approval.CloseTime > (1<<53-1)-approval.SettlementWindowSeconds || approval.Locktime < 60 || approval.CloseTime+approval.SettlementWindowSeconds > approval.Locktime-60 {
+		return errors.New("payment approval V2 settlement window exceeds the locktime bound")
+	}
+	return nil
+}
