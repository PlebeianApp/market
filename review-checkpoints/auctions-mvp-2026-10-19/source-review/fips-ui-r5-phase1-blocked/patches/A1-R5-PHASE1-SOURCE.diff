+// verifyPaymentApprovalV2Envelope validates the exact signed public envelope
+// and returns its domain-separated digest. It does not substitute for
+// VerifyPaymentApprovalLifetimeV2 or payment-lane bundle/branch verification.
+func verifyPaymentApprovalV2Envelope(approval PaymentApprovalV2, acceptedSellerP2PKXPub string, validatorIdentities map[string]struct{}) (string, error) {
+	if approval.Schema != PaymentApprovalSchemaV2 || approval.RefundKeyVersion != PaymentApprovalRefundKeyVersionV2 || approval.ApprovalLifetimePolicyVersion != PaymentApprovalLifetimePolicyV2 {
+		return "", errors.New("payment approval V2 schema or policy literal is invalid")
+	}
+	for _, value := range []string{approval.ChainID, approval.AuctionID, approval.OperationID, approval.BidID} {
+		if !printableASCII160(value) {
+			return "", errors.New("payment approval V2 signed text is outside printable ASCII grammar")
+		}
+	}
+	if !lowerHexExact(approval.AuthNetworkID, 32) || !lowerHexExact(approval.BidEventID, 32) || !lowerHexExact(approval.BidderActorID, 32) || !lowerHexExact(approval.ConditionFingerprint, 32) || !lowerHexExact(approval.WinnerPackageDigest, 32) || !lowerHexExact(approval.RefundPackageDigest, 32) || !lowerHexExact(approval.ApprovalEventID, 32) || !lowerHexExact(approval.ApprovalSignature, 64) {
+		return "", errors.New("payment approval V2 hexadecimal field is invalid")
+	}
+	if !safePositiveIntegerV2(approval.Amount) || !safePositiveIntegerV2(approval.CloseTime) || !safePositiveIntegerV2(approval.SettlementWindowSeconds) || !safePositiveIntegerV2(approval.ValidUntil) || !safePositiveIntegerV2(approval.Locktime) || !safePositiveIntegerV2(approval.ApprovalCreatedAt) {
+		return "", errors.New("payment approval V2 integer field is invalid")
+	}
+	if approval.SettlementWindowSeconds < 60 || approval.ApprovalCreatedAt > approval.ValidUntil || approval.ApprovalCreatedAt > approval.CloseTime || approval.CloseTime > approval.ValidUntil || approval.CloseTime > (1<<53-1)-approval.SettlementWindowSeconds || approval.Locktime < 60 || approval.CloseTime+approval.SettlementWindowSeconds > approval.Locktime-60 {
+		return "", errors.New("payment approval V2 intrinsic lifetime bound is invalid")
+	}
+	if !canonicalHTTPSOriginV2(approval.MintURL) {
+		return "", errors.New("payment approval V2 mint URL is not an exact HTTPS origin")
+	}
+	if !printableASCII160(approval.SellerP2PKXPub) || approval.SellerP2PKXPub != acceptedSellerP2PKXPub {
+		return "", errors.New("payment approval V2 seller xpub does not match accepted authority")
+	}
+	if !canonicalSellerDerivationPathV2(approval.SellerDerivationPath) {
+		return "", errors.New("payment approval V2 seller derivation path is not canonical")
+	}
+	actorIdentity, err := normalizeSecpIdentity(approval.BidderActorID)
+	if err != nil {
+		return "", errors.New("payment approval V2 actor identity is invalid")
+	}
+	mainIdentity, err := compressedSecpIdentityV2(approval.BidderCashuPublicKey)
+	if err != nil {
+		return "", errors.New("payment approval V2 MAIN identity is invalid")
+	}
+	refundIdentity, err := compressedSecpIdentityV2(approval.RefundCashuPublicKey)
+	if err != nil {
+		return "", errors.New("payment approval V2 REFUND identity is invalid")
+	}
+	sellerIdentity, err := compressedSecpIdentityV2(approval.SellerRecipientPublicKey)
+	if err != nil {
+		return "", errors.New("payment approval V2 seller recipient identity is invalid")
+	}
+	sellerRootIdentity, err := sellerXPubRootIdentity(approval.SellerP2PKXPub)
+	if err != nil {
+		return "", fmt.Errorf("payment approval V2 seller xpub: %w", err)
+	}
+	derived, err := deriveSellerChildPublicKey(approval.SellerP2PKXPub, approval.SellerDerivationPath)
+	if err != nil {
+		return "", fmt.Errorf("payment approval V2 seller derivation: %w", err)
+	}
+	if approval.SellerRecipientPublicKey != derived {
+		return "", errors.New("payment approval V2 seller recipient does not match xpub/path derivation")
+	}
+	if sellerRootIdentity == sellerIdentity {
+		return "", errors.New("payment approval V2 seller root aliases derived recipient")
+	}
+	if _, exists := validatorIdentities[sellerRootIdentity]; exists {
+		return "", errors.New("payment approval V2 seller root aliases validator identity")
+	}
+	if _, exists := validatorIdentities[sellerIdentity]; exists {
+		return "", errors.New("payment approval V2 seller recipient aliases validator identity")
+	}
+	identities := []string{actorIdentity, mainIdentity, refundIdentity}
+	for left := range identities {
+		for right := left + 1; right < len(identities); right++ {
+			if identities[left] == identities[right] {
+				return "", errors.New("payment approval V2 actor, MAIN, and REFUND identities are not distinct")
+			}
+		}
+		if identities[left] == sellerRootIdentity || identities[left] == sellerIdentity {
+			return "", errors.New("payment approval V2 identity aliases seller authority")
+		}
+		if _, exists := validatorIdentities[identities[left]]; exists {
+			return "", errors.New("payment approval V2 identity aliases validator identity")
+		}
+	}
+	content, err := marshalCanonicalUTF8JSON(paymentApprovalV2Content(approval))
+	if err != nil {
+		return "", err
+	}
+	if len(content) > MaxPaymentApprovalContentBytesV2 {
+		return "", errors.New("payment approval V2 signed content exceeds 4096 UTF-8 bytes")
+	}
+	canonicalApproval, err := marshalCanonicalUTF8JSON(approval)
+	if err != nil {
+		return "", err
+	}
+	if len(canonicalApproval) > MaxPaymentApprovalBytesV2 {
+		return "", errors.New("payment approval V2 exceeds 8192 canonical UTF-8 bytes")
+	}
+	var publicKey, eventID [32]byte
+	var signature [64]byte
+	if _, err := hex.Decode(publicKey[:], []byte(approval.BidderActorID)); err != nil {
+		return "", err
+	}
+	if _, err := hex.Decode(eventID[:], []byte(approval.ApprovalEventID)); err != nil {
+		return "", err
+	}
+	if _, err := hex.Decode(signature[:], []byte(approval.ApprovalSignature)); err != nil {
+		return "", err
+	}
+	signed := bidauth.SignedEvent{
+		Event: bidauth.UnsignedEvent{
+			PublicKey: publicKey, CreatedAt: approval.ApprovalCreatedAt, Kind: PaymentApprovalKind,
+			Tags:    [][]string{{"protocol", "plebeian-auction-fake-ecash-payment"}, {"version", "2"}, {"environment", approval.AuthNetworkID}, {"bid_event", approval.BidEventID}},
+			Content: string(content),
+		},
+		ID: eventID, Signature: signature,
+	}
+	if _, err := bidauth.VerifyEvent(signed, bidauth.EventLimitsForProfile(), bidauth.BTCECBIP340Verifier{}); err != nil {
+		return "", fmt.Errorf("payment approval V2 event: %w", err)
+	}
+	hash := sha256.New()
+	_, _ = hash.Write(paymentApprovalDigestDomainV2)
+	_, _ = hash.Write(canonicalApproval)
+	return hex.EncodeToString(hash.Sum(nil)), nil
+}
