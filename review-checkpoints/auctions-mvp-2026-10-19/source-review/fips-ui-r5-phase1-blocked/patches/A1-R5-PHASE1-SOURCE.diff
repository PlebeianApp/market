+func verifiedPaymentApprovalSetSHA256V2(approvals []PaymentApprovalV2, acceptedSellerP2PKXPub string, validatorIdentities map[string]struct{}) (string, error) {
+	if approvals == nil {
+		return "", errors.New("payment approval V2 set must be an array")
+	}
+	ordered := append(make([]PaymentApprovalV2, 0, len(approvals)), approvals...)
+	digests := make(map[string]struct{}, len(ordered))
+	operations := make(map[string]struct{}, len(ordered))
+	approvalEvents := make(map[string]struct{}, len(ordered))
+	bidEvents := make(map[string]struct{}, len(ordered))
+	bidIDs := make(map[string]struct{}, len(ordered))
+	for index, approval := range ordered {
+		digest, err := verifyPaymentApprovalV2Envelope(approval, acceptedSellerP2PKXPub, validatorIdentities)
+		if err != nil {
+			return "", fmt.Errorf("payment approval V2 %d: %w", index+1, err)
+		}
+		operationKey := approval.AuthNetworkID + "\x00" + approval.ChainID + "\x00" + approval.AuctionID + "\x00" + approval.OperationID
+		for _, item := range []struct {
+			value string
+			seen  map[string]struct{}
+		}{
+			{operationKey, operations}, {approval.ApprovalEventID, approvalEvents},
+			{approval.BidEventID, bidEvents}, {approval.BidID, bidIDs}, {digest, digests},
+		} {
+			value, seen := item.value, item.seen
+			if _, exists := seen[value]; exists {
+				return "", errors.New("payment approval V2 set contains a duplicate identity or digest")
+			}
+			seen[value] = struct{}{}
+		}
+	}
+	sort.Slice(ordered, func(left, right int) bool {
+		leftKey := [5]string{ordered[left].AuthNetworkID, ordered[left].ChainID, ordered[left].AuctionID, ordered[left].OperationID, ordered[left].ApprovalEventID}
+		rightKey := [5]string{ordered[right].AuthNetworkID, ordered[right].ChainID, ordered[right].AuctionID, ordered[right].OperationID, ordered[right].ApprovalEventID}
+		for index := range leftKey {
+			if leftKey[index] != rightKey[index] {
+				return leftKey[index] < rightKey[index]
+			}
+		}
+		return false
+	})
+	raw, err := marshalCanonicalUTF8JSON(ordered)
+	if err != nil {
+		return "", err
+	}
+	hash := sha256.New()
+	_, _ = hash.Write(paymentApprovalSetDomainV2)
+	_, _ = hash.Write(raw)
+	return hex.EncodeToString(hash.Sum(nil)), nil
+}
