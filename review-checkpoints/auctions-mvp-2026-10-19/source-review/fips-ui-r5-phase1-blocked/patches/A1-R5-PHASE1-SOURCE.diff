+func printableASCII160(value string) bool {
+	if len(value) < 1 || len(value) > 160 {
+		return false
+	}
+	for index := 0; index < len(value); index++ {
+		if value[index] < 0x21 || value[index] > 0x7e {
+			return false
+		}
+	}
+	return true
+}
+
+func canonicalSellerDerivationPathV2(value string) bool {
+	if !printableASCII160(value) || !strings.HasPrefix(value, "m/") {
+		return false
+	}
+	parts := strings.Split(value[2:], "/")
+	if len(parts) != 5 {
+		return false
+	}
+	for _, part := range parts {
+		if part == "" || (len(part) > 1 && part[0] == '0') {
+			return false
+		}
+		parsed, err := strconv.ParseUint(part, 10, 31)
+		if err != nil || strconv.FormatUint(parsed, 10) != part {
+			return false
+		}
+	}
+	return true
+}
+
+func canonicalHTTPSOriginV2(value string) bool {
+	if !printableASCII160(value) {
+		return false
+	}
+	parsed, err := url.Parse(value)
+	if err != nil || parsed.Scheme != "https" || parsed.User != nil || parsed.Hostname() == "" || parsed.Port() != "" || parsed.Path != "" || parsed.RawPath != "" || parsed.RawQuery != "" || parsed.Fragment != "" || parsed.ForceQuery || parsed.Opaque != "" {
+		return false
+	}
+	if parsed.Host != strings.ToLower(parsed.Host) || value != "https://"+parsed.Host {
+		return false
+	}
+	return true
+}
+
+func safePositiveIntegerV2(value int64) bool {
+	const maxSafeInteger = int64(1<<53 - 1)
+	return value > 0 && value <= maxSafeInteger
+}
+
+func compressedSecpIdentityV2(value string) (string, error) {
+	if len(value) != 66 || (value[:2] != "02" && value[:2] != "03") || strings.ToLower(value) != value {
+		return "", errors.New("identity is not a canonical compressed public key")
+	}
+	return normalizeSecpIdentity(value)
+}
