+	const PATH_2 = 'm/1'
+	const CHILD_1 = deriveAuctionChildP2pkPubkeyFromXpub(TEST_XPUB, PATH_1)
+	const CHILD_2 = deriveAuctionChildP2pkPubkeyFromXpub(TEST_XPUB, PATH_2)
