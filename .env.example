NODE_ENV=development
APP_RELAY_URL=wss://your-relay-url.com
APP_PRIVATE_KEY=<your_private_key_in_hex>
CVM_SERVER_KEY=<your_currency_server_private_key_in_hex>
# OG meta (optional): server-controlled origins for /products/:id shell fetch
# and og:url/og:image. Defaults to the fixed loopback (no config required).
#APP_SHELL_ORIGIN=http://localhost:3000
#APP_PUBLIC_ORIGIN=https://market.example.com

# Optional runtime instance overrides. Kind 31990 settings take precedence.
# INSTANCE_NAME=My Market
# INSTANCE_DISPLAY_NAME=My Market
# INSTANCE_PICTURE_URL=https://market.example/images/logo.svg
# INSTANCE_BANNER_URL=https://market.example/images/banner.png
# INSTANCE_OWNER_PUBKEY=<owner_public_key_in_hex>
# INSTANCE_ALLOW_REGISTER=true
# INSTANCE_DEFAULT_CURRENCY=USD
# INSTANCE_CONTACT_EMAIL=support@market.example
# INSTANCE_HANDLER_ID=market-handler
# INSTANCE_SITE_URL=https://market.example
# INSTANCE_PUBLIC_RELAYS=wss://relay-one.example,wss://relay-two.example
# INSTANCE_TRUSTED_MINTS=https://mint-one.example,https://mint-two.example
# INSTANCE_BUG_RELAY=wss://bugs.example
# INSTANCE_TERMS_URL=https://market.example/terms
# INSTANCE_SUPPORT_CONTACT=support@market.example
# INSTANCE_SHOW_NOSTR_LINK=false
# INSTANCE_TWITTER_URL=https://twitter.com/example
# INSTANCE_NEWSLETTER_URL=https://example.substack.com
# INSTANCE_TELEGRAM_URL=https://t.me/example
# INSTANCE_GITHUB_URL=https://github.com/example/market
# BLOSSOM_SERVER=https://blossom.example
# NIP96_SERVER=https://media.example

# Extensions (ADR-0023). None are enabled by default. <ID> is the extension id
# uppercased with . and - replaced by _. Unprefixed fields are private config
# (server-only); PUBLIC_ fields are published in /api/config.
# EXTENSION_<ID>_ENABLED=true
# EXTENSION_<ID>_PUBLIC_<FIELD>=value
# EXTENSION_<ID>_<FIELD>=secret-value
# EXTENSION_<ID>_EGRESS=https://api.provider.example
# EXTENSION_<ID>_HOST_PORTS=relays:read,http
# Built-in: product image describer (mock-up, no network, no AI). Admin page: /dashboard/app-settings/extensions
# EXTENSION_PRODUCT_IMAGE_DESCRIBER_ENABLED=true
# EXTENSION_PRODUCT_IMAGE_DESCRIBER_PUBLIC_MAX_CHARS=600
# Built-in: Routstr listing drafter. Real AI drafts via a local routstrd daemon (https://routstr.com/routstrd)
# on http://127.0.0.1:8008; routstrd pays from its own Cashu wallet, so there is no API key. Never expose port 8008.
# Dev without a daemon or wallet: `bun run dev:routstrd-stub`.
# EXTENSION_ROUTSTR_LISTING_DRAFTER_ENABLED=true
# EXTENSION_ROUTSTR_LISTING_DRAFTER_PUBLIC_MODEL=<vision model id from `routstrd models`>
# EXTENSION_ROUTSTR_LISTING_DRAFTER_PUBLIC_PROVIDER=https://node.example   # optional strict pin to one node
# EXTENSION_ROUTSTR_LISTING_DRAFTER_PUBLIC_MAX_TOKENS=700
# Loopback egress is blocked in production unless the operator opts in per extension:
# EXTENSION_ROUTSTR_LISTING_DRAFTER_ALLOW_LOCALHOST=true
# Extension store repository: curator keys (hex or npub) whose NIP-51 list
# (kind 30000, d=plebeian-extension-registry) names ContextVM extension servers.
# Relays default to APP_RELAY_URL.
# EXTENSIONS_REGISTRY_CURATORS=npub1...
# EXTENSIONS_REGISTRY_RELAYS=wss://relay.example
# Where admin store decisions (added extension servers, bindings) persist. No secrets are stored.
# EXTENSIONS_STATE_PATH=./data/extensions.sqlite
# Key the marketplace signs with when calling bound remote extension tools over ContextVM
# (hex or nsec). Never the app key. If unset, a per-process key is generated.
# EXTENSIONS_CLIENT_KEY=
