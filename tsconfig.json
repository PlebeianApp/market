{
	"compilerOptions": {
		"jsx": "react-jsx",
		"allowJs": true,
		"strict": true,
		"strictNullChecks": true,
		"moduleResolution": "bundler",
		"module": "preserve",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@plebeian/contract": ["./packages/contract/src/index.ts"],
			"@plebeian/web": ["./packages/web/src/index.ts"],
			"@plebeian/napplet": ["./packages/napplet/src/index.ts"],
			"@plebeian/product": ["./packages/product/src/index.ts"],
			"@plebeian/browse": ["./packages/browse/src/index.ts"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "scripts/**/*.ts"]
}
