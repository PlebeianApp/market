{
	"compilerOptions": {
		"jsx": "react-jsx",
		"allowJs": true,
		"strict": true,
		"strictNullChecks": true,
		"moduleResolution": "bundler",
		"module": "preserve",
		"target": "ESNext",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@sdk/*": ["./sdk/*"],
			"@ui/*": ["./ui/*"],
			"@platform/*": ["./platform/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "scripts/**/*.ts"]
}
